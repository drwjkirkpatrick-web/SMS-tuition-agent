# ═══════════════════════════════════════════════════
# .env.example — Template for environment variables
# ═══════════════════════════════════════════════════
# Copy this file to .env and fill in real values.
# .env is listed in .gitignore and must NEVER be committed.
# ═══════════════════════════════════════════════════

# ── Database ──
DATABASE_URL=postgresql+asyncpg://sms_user:sms_pass@db:5432/sms_tuition
# Format: postgresql+asyncpg://USER:PASS@HOST:PORT/DBNAME
# asyncpg is the async driver; SQLAlchemy handles the ORM layer.

# ── Redis (Celery broker + cache) ──
REDIS_URL=redis://redis:6379/0
# Redis runs in a Docker container named 'redis'. Celery uses it as
# both the message broker (who gets which task) and result backend.

# ── SMS Provider: Twilio ──
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15551234567
# The phone number must be purchased in Twilio and SMS-enabled.

# ── Webhook Security ──
WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Used to sign inbound webhooks so we can verify they came from Twilio.

# ── Application ──
APP_ENV=development
# Options: development, staging, production
# Controls log level, error detail exposure, and quiet-hours enforcement.

SCHOOL_TIMEZONE=America/Los_Angeles
# IANA timezone name. All due dates and quiet hours are interpreted in
# this zone. Use `pytz.all_timezones` or tz database to find yours.

LOG_LEVEL=INFO
# DEBUG for development, INFO for staging, WARNING for production.

# ── Security ──
BACKUP_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 32-byte hex key for encrypting database backups. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"

ADMIN_TOKEN_HASH=$2b$12$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# bcrypt hash of the director dashboard access token.
# Generate with: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('your-token-here'))"
